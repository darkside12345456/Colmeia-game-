# Copia este ficheiro para ".env" e preenche (o .env nunca vai para o Git).
# Só entram aqui identificadores PÚBLICOS por natureza (secção 11.1).
# Chaves SECRETAS (API secreta RevenueCat, contas de serviço Google) NUNCA entram na app.

# "fake" = anúncios/compras simulados (testes); "real" = AdMob/RevenueCat (só na app Android)
VITE_ADS_MODE=fake
VITE_IAP_MODE=fake

# AdMob - IDs de BLOCOS de anúncio (vazio = usa os IDs de TESTE oficiais da Google)
VITE_ADMOB_REWARDED_ID=
VITE_ADMOB_REWARDED_INTERSTITIAL_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_BANNER_ID=
# Pôr "false" só no build final de produção, depois de testar tudo
VITE_ADMOB_TESTING=true

# RevenueCat - chave PÚBLICA do SDK para Android (começa por "goog_")
VITE_REVENUECAT_PUBLIC_KEY=

# Remote config (JSON público via HTTPS, opcional). Vazio = usa os valores embutidos.
VITE_REMOTE_CONFIG_URL=

# Email de suporte mostrado nas Definições e na loja
VITE_SUPPORT_EMAIL=suporte@exemplo.pt
# URL público da política de privacidade (ex.: GitHub Pages)
VITE_PRIVACY_URL=https://exemplo.github.io/colmeia-doce/privacidade.html
